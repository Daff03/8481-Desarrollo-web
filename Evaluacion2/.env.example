# Variables de docker-compose.yml. Copia este archivo como ".env" (junto a docker-compose.yml) y ajusta lo que necesites.
# Aquí NO van secretos: esos los genera scripts/gen_secrets.py en ./secrets (ignorada por git) y el secrets-manager los entrega por referencia.

# URL REAL del frontend servido por XAMPP, SIN barra final. Se usa en el enlace del correo de verificación y para volver desde
# la pasarela de pago. Debe coincidir con lo que abres en el navegador (carpeta "frontend" del proyecto dentro de htdocs).
FRONTEND_URL=http://localhost:8080/8481-Desarrollo-web/8481-Desarrollo-web/Evaluacion2/frontend

# Origen (esquema + host + puerto, sin ruta) desde el que el navegador llama al gateway; permite CORS con cookie. Varios, separados por coma.
ALLOWED_ORIGINS=http://localhost:8080

# URL pública de la pasarela de pago simulada (la abre el navegador).
PROVIDER_PUBLIC_URL=http://localhost:9000

# true solo cuando haya HTTPS; con http://localhost debe ser false o el navegador descarta la cookie de sesión.
COOKIE_SECURE=false

# Exigir correo verificado para iniciar sesión (el enlace llega a mail-outbox/outbox.jsonl).
REQUIRE_EMAIL_VERIFIED=true

# Crear al arrancar: admin y cajero (auth) y los 12 platos (inventory), solo si no existen.
SEED_ON_START=true

# Minutos para pagar un pedido antes de que se anule solo y devuelva el stock.
UNPAID_TTL_MINUTES=30

# Límite de solicitudes por minuto e IP en el gateway (general y para el login). En Docker Desktop todos los navegadores
# de tu equipo llegan con la misma IP, así que no lo bajes demasiado. Si ves error 429 al probar, súbelo.
RATE_LIMIT_PER_MIN=300
LOGIN_RATE_PER_MIN=10

# Permitir introspección de GraphQL (solo para desarrollo).
GRAPHQL_INTROSPECTION=false
