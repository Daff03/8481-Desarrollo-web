# Solo referencias simbólicas del secrets-manager, nunca valores reales.
# Las credenciales de cada servicio (SERVICE_ID, SERVICE_KEY) las genera scripts/gen_secrets.py en secrets/env/.
SECRETS_MANAGER_URL=http://secrets-manager:8200
INTERNAL_JWT_REF=internal-jwt
GATEWAY_AUTH_REF=gw-auth
AUTH_CLIENTS_REF=auth-clients
ORDERS_INVENTORY_REF=orders-inventory
ORDERS_PAYMENTS_REF=orders-payments
PROVIDER_WEBHOOK_REF=prov-webhook
# Un ref de BD por servicio (db-auth, db-clients, db-inventory, db-orders, db-payments)
MONGO_URL=mongodb://mongo:27017
